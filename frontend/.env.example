# Default: backend during local dev.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public path the built app is served from.
# - Leave empty (or unset) for deployments at the domain root, including local
#   `npm run dev`.
# - Set to "/<repo>/" when deploying to a GitHub Pages project site.
#   Example: VITE_BASE=/CareerSetu/
VITE_BASE=
