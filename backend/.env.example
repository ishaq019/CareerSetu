APP_NAME=CareerSetu
ENVIRONMENT=development

# Database.
# Default (leave unset) uses a local SQLite file — no external services needed.
# For production use a Neon *pooled* PostgreSQL URL and keep sslmode=require:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-HOST-POOLER.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=sqlite:///./careersetu.db
DATABASE_POOL_MODE=auto

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_MINUTES=10080

# Google OAuth provider boundary; callback flow must be configured before production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM / RAG (Groq is the only supported provider).
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_FAST_MODEL=llama-3.1-8b-instant
LLM_QUALITY_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200
LLM_CONTEXT_CHARS=12000

# ChromaDB knowledge store.
# Preferred: Chroma Cloud (https://www.trychroma.com/) — set all three below.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=careersetu
# Fallback: self-hosted Chroma server (used only when CHROMA_API_KEY is empty).
CHROMA_HOST=localhost
CHROMA_PORT=8001
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=100000

# Comma-separated administrator emails allowed to ingest trusted knowledge.
KNOWLEDGE_ADMIN_EMAILS=
