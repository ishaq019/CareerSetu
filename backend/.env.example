APP_NAME=CareerSetu
ENVIRONMENT=development

# Database.
# Default (leave unset) uses a local SQLite file — no external services needed.
# For production use a Neon *pooled* PostgreSQL URL and keep sslmode=require:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-HOST-POOLER.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=sqlite:///./careersetu.db
DATABASE_POOL_MODE=auto

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_MINUTES=10080

# Google OAuth 2.0 (authorization-code flow).
# 1. Create an OAuth client (type: Web application) in Google Cloud Console.
# 2. Add an Authorized redirect URI that EXACTLY matches GOOGLE_REDIRECT_URI below.
# 3. Put the real values in .env (never commit them) — these are placeholders.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Backend callback. Local dev value shown; in production use your API domain,
# e.g. https://your-backend.vercel.app/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where users land after a successful login (your SPA origin).
FRONTEND_URL=http://localhost:5173

# LLM / RAG — OpenAI-compatible gateway (OpenRouter).
# 1. Create a key at https://openrouter.ai/keys and paste it into LLM_API_KEY.
# 2. LLM_MODEL uses a FREE-tier model (slugs ending in ":free"). Browse
#    https://openrouter.ai/models?max_price=0 and swap it if this one is retired.
# One model is used for every task. Leave LLM_API_KEY empty to disable AI routes.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_AUTH_SCHEME=bearer
# Optional OpenRouter attribution (shows your app in their dashboard rankings).
LLM_REFERER=
LLM_APP_TITLE=CareerSetu
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200
LLM_CONTEXT_CHARS=12000

# ChromaDB knowledge store.
# Preferred: Chroma Cloud (https://www.trychroma.com/) — set all three below.
# NOTE: CHROMA_DATABASE is CASE-SENSITIVE and must EXACTLY match the database
# name shown in your Chroma Cloud dashboard (e.g. "Careersetu" != "careersetu").
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=careersetu
# Fallback: self-hosted Chroma server (used only when CHROMA_API_KEY is empty).
CHROMA_HOST=localhost
CHROMA_PORT=8001
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=100000

# Comma-separated administrator emails allowed to ingest trusted knowledge.
KNOWLEDGE_ADMIN_EMAILS=
